  "name": "Humanoid Everyday",
  "title": "Humanoid Everyday: A Comprehensive Robotic Dataset for Open-World Humanoid Manipulation",
  "authors": "Zhenyu Zhao et al.",
  "year": 2025,
  "venue": "arXiv 2510.08807",
  "summary": "Teleoperated Unitree G1 and H1 humanoids on 246 everyday tasks; the G1 episodes carry Unitree Dex3-1 hand pressure sensors (9 per hand).",
  "embodiment": "robot",
  "hand": "Unitree Dex3-1 (7 DoF) x 2 on G1; Inspire (6 DoF) x 2 on H1",
  "bimanual": true,
  "sensor": {
   "type": "unspecified",
   "taxels_per_hand": 33,
   "sensors_per_hand": 9,
   "coverage": [
    "tip",
    "phalanx",
    "palm"
   ],
   "rate_hz": 30,
   "note": "G1 episodes only: observation.tactile.values (18, 4) float32 + sensor_id 1-18; up to 4 readings per sensor, NaN-padded. In the release only 22 of 72 cells change (the rest are a constant 30000), and sensor 1 plus the first cell of sensor 2 hold odometry values. H1/Inspire episodes have empty tactile arrays.",
   "maker": "Unitree",
   "model": "Dex3-1 hand pressure sensors",
   "principle": "unspecified",
   "range": "10 g - 2500 g (maker spec, 1 cm cylinder)"
  },
